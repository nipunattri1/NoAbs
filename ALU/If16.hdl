CHIP If16 {
    IN cond, a[16], b[16];
    OUT out[16];

    PARTS:
    // if cond then => a else b
    Not(in=cond, out=notcond);
    SAnd16(a=a, sel=cond, out=aAndcond); // returns a if condition is true else false
    SAnd16(a=b, sel=notcond, out=bAndnotcond);
    Or16(a=aAndcond, b=bAndnotcond, out=out);
}