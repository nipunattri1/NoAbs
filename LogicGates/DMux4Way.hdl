
/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    Not(in=sel[0], out=notS2);
    Not(in=sel[1], out=notS1);
    And(a=notS1, b=notS2, out=aCond);
    And(a=notS1, b=sel[0], out=bCond);
    And(a=sel[1], b=notS2, out=cCond);
    And(a=sel[1], b=sel[0], out=dCond);
    And(a=in, b=aCond, out=a);
    And(a=in, b=bCond, out=b);
    And(a=in, b=cCond, out=c);
    And(a=in, b=dCond, out=d);
}
