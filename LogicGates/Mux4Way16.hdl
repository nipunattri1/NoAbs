// File name: projects/1/Mux4Way16.hdl
/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 **/
CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
    PARTS:
    Not(in=sel[0], out=S0);
    Not(in=sel[1], out=S1);

    And(a=S0, b=S1, out=aCond);
    And(a=sel[0], b=S1, out=bCond);
    And(a=S0, b=sel[1], out=cCond);
    And(a=sel[0], b=sel[1], out=dCond);

    SAnd16(sel=aCond, a=a, out=temp1);
    SAnd16(sel=bCond, a=b, out=temp2);
    SAnd16(sel=cCond, a=c, out=temp3);
    SAnd16(sel=dCond, a=d, out=temp4);

    Or16(a=temp1, b=temp2, out=temp5);
    Or16(a=temp5, b=temp3, out=temp6);
    Or16(a=temp6, b=temp4, out=out);
}