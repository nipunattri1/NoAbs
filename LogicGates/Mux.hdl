
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    Not(in=sel, out=notsel);
    And(a=notsel, b=a, out=notselAnda);
    And(a=sel, b=b, out=selAndb);
    Or(a=selAndb, b=notselAnda, out=out);
    //// Replace this comment with your code.
}
