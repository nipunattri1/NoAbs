// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    Not(in=sel[2], out=notS1);
    Not(in=sel[1], out=notS2);
    Not(in=sel[0], out=notS3);
    And(a=notS1, b=notS2, out=temp1);
    And(a=temp1, b=notS3, out=aCond);

    And(a=notS1, b=notS2, out=temp2);
    And(a=temp2, b=sel[0], out=bCond);

    And(a=notS1, b=sel[1], out=temp3);
    And(a=temp3, b=notS3, out=cCond);

    And(a=notS1, b=sel[1], out=temp4);
    And(a=temp4, b=sel[0], out=dCond);

    And(a=sel[2], b=notS2, out=temp5);
    And(a=temp5, b=notS3, out=eCond);

    And(a=sel[2], b=notS2, out=temp6);
    And(a=temp6, b=sel[0], out=fCond);

    And(a=sel[2], b=sel[1], out=temp7);
    And(a=temp7, b=notS3, out=gCond);

    And(a=sel[2], b=sel[1], out=temp8);
    And(a=temp8, b=sel[0], out=hCond);

    And(a=aCond, b=in, out=a);
    And(a=bCond, b=in, out=b);
    And(a=cCond, b=in, out=c);
    And(a=dCond, b=in, out=d);
    And(a=eCond, b=in, out=e);
    And(a=fCond, b=in, out=f);
    And(a=gCond, b=in, out=g);
    And(a=hCond, b=in, out=h);
    
}
