
/**
 * 8-way 16-bit multiplexor:
 * out = a if sel = 000
 *       b if sel = 001
 *       c if sel = 010
 *       d if sel = 011
 *       e if sel = 100
 *       f if sel = 101
 *       g if sel = 110
 *       h if sel = 111
 */
CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

    PARTS:
    Not(in=sel[0], out=S0);
    Not(in=sel[1], out=S1);
    Not(in=sel[2], out=S2);

    And(a=S0, b=S1, out=temp1);
    And(a=temp1, b=S2, out=aCond);

    And(a=sel[0], b=S1, out=temp2);
    And(a=temp2, b=S2, out=bCond);

    And(a=S0, b=sel[1], out=temp3);
    And(a=temp3, b=S2, out=cCond);

    And(a=sel[0], b=sel[1], out=temp4);
    And(a=temp4, b=S2, out=dCond);

    And(a=S0, b=S1, out=temp5);
    And(a=temp5, b=sel[2], out=eCond);

    And(a=sel[0], b=S1, out=temp6);
    And(a=temp6, b=sel[2], out=fCond);

    And(a=S0, b=sel[1], out=temp7);
    And(a=temp7, b=sel[2], out=gCond);

    And(a=sel[0], b=sel[1], out=temp8);
    And(a=temp8, b=sel[2], out=hCond);


    And16(a=a, b=true, out=atemp1);
    And16(a=a, b=false, out=atemp2);
    Mux16(b=atemp1, a=atemp2, sel=aCond, out=tempa);


    And16(a=b, b=true, out=btemp1);
    And16(a=b, b=false, out=btemp2);
    Mux16(b=btemp1, a=btemp2, sel=bCond, out=tempb);


    And16(a=c, b=true, out=ctemp1);
    And16(a=c, b=false, out=ctemp2);
    Mux16(b=ctemp1, a=ctemp2, sel=cCond, out=tempc);


    And16(a=d, b=true, out=dtemp1);
    And16(a=d, b=false, out=dtemp2);
    Mux16(b=dtemp1, a=dtemp2, sel=dCond, out=tempd);


    And16(a=e, b=true, out=etemp1);
    And16(a=e, b=false, out=etemp2);
    Mux16(b=etemp1, a=etemp2, sel=eCond, out=tempe);


    And16(a=f, b=true, out=ftemp1);
    And16(a=f, b=false, out=ftemp2);
    Mux16(b=ftemp1, a=ftemp2, sel=fCond, out=tempf);


    And16(a=g, b=true, out=gtemp1);
    And16(a=g, b=false, out=gtemp2);
    Mux16(b=gtemp1, a=gtemp2, sel=gCond, out=tempg);


    And16(a=h, b=true, out=htemp1);
    And16(a=h, b=false, out=htemp2);
    Mux16(b=htemp1, a=htemp2, sel=hCond, out=temph);

    Or16(a=tempa, b=tempb, out=dummy1);
    Or16(a=dummy1, b=tempc, out=dummy2);
    Or16(a=dummy2, b=tempd, out=dummy3);
    Or16(a=dummy3, b=tempe, out=dummy4);
    Or16(a=dummy4, b=tempf, out=dummy5);
    Or16(a=dummy5, b=tempg, out=dummy6);
    Or16(a=dummy6, b=temph, out=out);
}
