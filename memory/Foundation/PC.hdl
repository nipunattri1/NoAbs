
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    // 0 or in or out [Condition for change] 
    Or(a=reset, b=load, out=temp);
    Or(a=temp, b=inc, out=TLoad); // TLoad - temp load


    // decide input
    Not(in=reset, out=Notreset);
    Not(in=load, out=Notload);

    And(a=Notreset, b=load, out=sel0);
    And(a=Notreset, b=Notload, out=sel1);

    // compute inc 
    Inc16(in=outCopy, out=add);

    /*
    The case of inc happens if both above cases don't occur and last case is handled by TLoad :)
    
    */

    Mux4Way16(a=false, b=in, c=add, d=false, sel[0]=sel0, sel[1]=sel1, out=input);

    Register(in=input, load=TLoad, out=out, out=outCopy);


    

    // Mux4Way16(a=false, b=in, c=inc, d=prev, sel=sel, out=out);

}
